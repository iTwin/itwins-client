{
  "name": "@itwin/itwins-client",
  "version": "3.1.3",
  "description": "iTwins client for the iTwin platform",
  "main": "./lib/cjs/itwins-client.js",
  "module": "./lib/esm/itwins-client.js",
  "types": "./lib/cjs/itwins-client.d.ts",
  "files": [
    "lib",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/itwins-client.d.ts",
        "default": "./lib/esm/itwins-client.js"
      },
      "require": {
        "types": "./lib/cjs/itwins-client.d.ts",
        "default": "./lib/cjs/itwins-client.js"
      }
    }
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run -s build:cjs && pnpm run -s build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"fs.writeFileSync('lib/esm/package.json', JSON.stringify({ type: 'module' }))\"",
    "clean": "rimraf lib",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "check": "changeset status",
    "lint": "eslint -f visualstudio \"./src/**/*.ts\" 1>&2",
    "lint:fix": "pnpm run lint --fix",
    "test": "vitest run",
    "test:esm": "node --input-type=module -e \"const m = await import('@itwin/itwins-client'); if (typeof m.ITwinsClient !== 'function') throw new Error('ESM entry point is broken');\"",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "pnpm build && playwright test --ui",
    "test:debug": "vitest --reporter=verbose --no-coverage",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "Bentley",
    "iTwin",
    "digital-twin",
    "IModelHub",
    "project",
    "asset"
  ],
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "http://www.bentley.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iTwin/itwins-client"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@changesets/types": "7.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@itwin/build-tools": "^5.15.1",
    "@itwin/core-bentley": "^5.15.1",
    "@itwin/eslint-plugin": "^6.1.1",
    "@itwin/oidc-signin-tool": "^6.1.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^18.0.10",
    "dotenv-expand": "^1000.0.0",
    "eslint": "^9.39.5",
    "rimraf": "^6.1.4",
    "source-map-loader": "^5.0.0",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": ">=7.0.3",
      "diff": ">=8.0.3",
      "esbuild": ">=0.25.0",
      "lodash": ">=4.18.0",
      "@changesets/write>human-id": "4.1.1",
      "minimatch@10>brace-expansion": "^5.0.8",
      "vitest>tinypool": "^2.1.2",
      "@itwin/oidc-signin-tool>@playwright/test": "$@playwright/test"
    }
  }
}
